generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id           String   @id @default(cuid())
  nome         String
  cpf          String?  @unique
  email        String   @unique
  senhaHash    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Leito {
  id           String       @id
  nome         String
  tipo         String       @default("N")
  valorDiaria  Float        @default(0)
  internacoes  Internacao[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model FormaPagamento {
  id          String      @id
  nome        String      @unique
  pagamentos  Pagamento[]
  createdAt   DateTime    @default(now())
}

model Pagamento {
  id                String          @id @default(cuid())
  valor             Float
  pagoEm            DateTime        @default(now())
  internacaoId      String
  formaPagamentoId  String
  internacao        Internacao      @relation(fields: [internacaoId], references: [id], onDelete: Cascade)
  formaPagamento    FormaPagamento  @relation(fields: [formaPagamentoId], references: [id])
  createdAt         DateTime        @default(now())
}

model Tutor {
  id        String   @id @default(cuid())
  nome      String
  telefone  String
  cpf       String?
  email     String?
  pets      Pet[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pet {
  id             String       @id @default(cuid())
  nome           String
  especie        String
  raca           String?
  dataNascimento DateTime?
  tutorId        String
  tutor          Tutor        @relation(fields: [tutorId], references: [id])
  internacoes    Internacao[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Internacao {
  id               String      @id @default(cuid())
  petNome          String
  especie          String
  tutorNome        String
  entradaEm        DateTime    @default(now())
  dataSaida        DateTime?
  descricao        String      @default("")
  quantidadeDiarias Int        @default(0)
  valorDiarias     Float      @default(0)
  status           String      @default("estavel")
  baixa            Boolean     @default(false)
  proximaMedicacao String
  observacao       String      @default("")
  petId            String?
  pet              Pet?        @relation(fields: [petId], references: [id])
  leitoId          String?
  leito            Leito?      @relation(fields: [leitoId], references: [id])
  medicacoes       Medicacao[]
  pagamentos       Pagamento[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Medicacao {
  id               String     @id @default(cuid())
  nome             String
  descricao        String     @default("")
  horarios         String     @default("[]")
  cor              String     @default("bg-teal-500")
  via              String     @default("Oral")
  unidade          String     @default("mg")
  quantidade       Float      @default(1)
  valorDose        Float      @default(0)
  dosesAplicadas   Int        @default(0)
  frequenciaHoras  Int        @default(8)
  primeiroHorario  String     @default("08:00")
  fimEm            DateTime?
  internacaoId     String
  internacao       Internacao @relation(fields: [internacaoId], references: [id], onDelete: Cascade)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}
